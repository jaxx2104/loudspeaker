{
  "name": "loudspeaker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "ci": "biome ci . && tsc --noEmit && bun test"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "0.2.15",
    "@ai-sdk/mistral": "1.2.8",
    "@mastra/core": "0.13.1",
    "@octokit/graphql": "8.1.1",
    "@openrouter/ai-sdk-provider": "0.7.5",
    "ai": "4.3.19",
    "twitter-api-v2": "1.15.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
